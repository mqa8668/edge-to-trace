# Copy to .env (make up does this for you via scripts/bootstrap.sh, which fills the blanks with random values).
# Never commit .env.

# Password for the Postgres superuser and the app role. Generated if blank.
POSTGRES_PASSWORD=

# Shared secret for the chaos admin API (header X-Chaos-Token). Generated if blank.
# An empty value disables the admin API in every service.
CHAOS_TOKEN=

# Grafana admin password (used from v0.1 phase 2 on). Generated if blank.
GRAFANA_ADMIN_PASSWORD=

# Where the services send OTLP traces/metrics. The collector arrives in phase 2; until then
# exports fail quietly (a warning in the logs) and the services run normally.
# Set OTEL_TRACES_EXPORTER=none and OTEL_METRICS_EXPORTER=none to silence them completely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# Percentage of healthy, fast traces the collector keeps (slow and failed traces are always kept).
TAIL_SAMPLING_BASELINE_PERCENT=100

# Set to 1 if `make doctor` says Beyla needs the privileged override (Docker Desktop, hardened kernels).
BEYLA_PRIVILEGED=0

# Anonymous read-only Grafana viewer. Safe here because every port binds to 127.0.0.1.
GRAFANA_ANONYMOUS_VIEWER=true

# Let the anonymous viewer open Explore. The demo needs it for exemplar and trace links; `make demo` sets it to true.
# Keep it false for any Grafana that is reachable by other people.
GRAFANA_VIEWERS_CAN_EDIT=false

# Build metadata shown as service.version. The Makefile sets it from git when unset.
GIT_SHA=dev
